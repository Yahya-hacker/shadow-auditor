{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadow-auditor.dev/protocol/1.0/schemas/health-response.schema.json",
  "title": "HealthResponse",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "degraded"
      ]
    },
    "protocolVersion": {
      "$ref": "./protocol-version.schema.json"
    },
    "serverTime": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    }
  },
  "required": [
    "status",
    "protocolVersion",
    "serverTime"
  ]
}
