{
  "$defs": {
    "Base64Url32": {
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
      "type": "string"
    },
    "Base64Url64": {
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$",
      "type": "string"
    },
    "CanonicalDecimal": {
      "maxLength": 40,
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$",
      "type": "string"
    },
    "DetachedSignature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "type": "string"
        },
        "keyId": {
          "$ref": "#/$defs/Uuid"
        },
        "signature": {
          "$ref": "#/$defs/Base64Url64"
        }
      },
      "required": [
        "algorithm",
        "keyId",
        "signature"
      ],
      "type": "object"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._/-]*$",
      "type": "string"
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Structural JSON Schema validation is necessary but not sufficient. This value must also pass the bounded canonical JSON validator and UTF-8 byte limits frozen in the protocol manifest.",
      "maxProperties": 256,
      "type": "object"
    },
    "JsonValue": {
      "description": "A structural JSON value. After schema validation, every canonicalized or signed instance must pass the bounded canonical JSON validator. JSON Schema cannot enforce aggregate depth, node count, canonical payload bytes, or UTF-8 string bytes.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxItems": 1024,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxProperties": 256,
          "type": "object"
        }
      ]
    },
    "Nonce": {
      "pattern": "^(?:(?:[A-Za-z0-9_-]{4}){6,21}|(?:[A-Za-z0-9_-]{4}){5,21}[A-Za-z0-9_-][AQgw]|(?:[A-Za-z0-9_-]{4}){5,20}[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])$",
      "type": "string"
    },
    "PayloadLimits": {
      "additionalProperties": false,
      "description": "A syntactically valid offer is not necessarily compatible. Before enrollment or session creation, both peers MUST call the Protocol 1.0 semantic negotiation helper, select the fieldwise minima, enforce every x-shadow-limit-invariants relation, and pin the resulting profile digest. JSON Schema does not enforce these cross-field relations.",
      "properties": {
        "maxArrayItems": {
          "maximum": 1024,
          "minimum": 7,
          "type": "integer"
        },
        "maxBodyBytes": {
          "maximum": 1048576,
          "minimum": 21504,
          "type": "integer"
        },
        "maxCanonicalDepth": {
          "maximum": 32,
          "minimum": 4,
          "type": "integer"
        },
        "maxCanonicalNodes": {
          "maximum": 10000,
          "minimum": 321,
          "type": "integer"
        },
        "maxEventBytes": {
          "maximum": 262144,
          "minimum": 17408,
          "type": "integer"
        },
        "maxObjectKeys": {
          "maximum": 256,
          "minimum": 32,
          "type": "integer"
        },
        "maxRecoveryItemBytes": {
          "maximum": 786432,
          "minimum": 5120,
          "type": "integer"
        },
        "maxRecoveryItemDepth": {
          "maximum": 30,
          "minimum": 2,
          "type": "integer"
        },
        "maxRecoveryItemNodes": {
          "maximum": 9744,
          "minimum": 65,
          "type": "integer"
        },
        "maxRecoveryPageItems": {
          "maximum": 128,
          "minimum": 1,
          "type": "integer"
        },
        "maxRecoveryPageOverheadBytes": {
          "maximum": 262144,
          "minimum": 16384,
          "type": "integer"
        },
        "maxRecoveryPageOverheadNodes": {
          "maximum": 256,
          "minimum": 256,
          "type": "integer"
        },
        "maxStringBytes": {
          "maximum": 65536,
          "minimum": 128,
          "type": "integer"
        },
        "maxToolArgumentsBytes": {
          "maximum": 524288,
          "minimum": 1024,
          "type": "integer"
        },
        "maxToolDescriptors": {
          "maximum": 128,
          "minimum": 1,
          "type": "integer"
        },
        "maxToolResultValueBytes": {
          "maximum": 524288,
          "minimum": 1024,
          "type": "integer"
        }
      },
      "required": [
        "maxArrayItems",
        "maxBodyBytes",
        "maxCanonicalDepth",
        "maxCanonicalNodes",
        "maxEventBytes",
        "maxRecoveryItemBytes",
        "maxRecoveryItemDepth",
        "maxRecoveryItemNodes",
        "maxRecoveryPageItems",
        "maxRecoveryPageOverheadBytes",
        "maxRecoveryPageOverheadNodes",
        "maxObjectKeys",
        "maxStringBytes",
        "maxToolArgumentsBytes",
        "maxToolDescriptors",
        "maxToolResultValueBytes"
      ],
      "type": "object",
      "x-shadow-limit-invariants": [
        "maxBodyBytes >= maxRecoveryItemBytes + maxRecoveryPageOverheadBytes",
        "maxCanonicalNodes >= maxRecoveryItemNodes + maxRecoveryPageOverheadNodes",
        "maxCanonicalDepth >= maxRecoveryItemDepth + 2",
        "maxArrayItems >= maxRecoveryPageItems",
        "maxArrayItems >= maxToolDescriptors",
        "maxBodyBytes >= maxEventBytes",
        "maxRecoveryItemBytes >= maxToolArgumentsBytes + 4096",
        "maxEventBytes >= maxToolArgumentsBytes + 16384",
        "maxBodyBytes >= maxToolResultValueBytes",
        "maxRecoveryItemNodes >= 65",
        "maxCanonicalNodes >= 257"
      ],
      "x-shadow-semantic-validator": "negotiateProtocolLimits"
    },
    "PositiveSafeInteger": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "ProtocolVersion": {
      "const": "1.0",
      "type": "string"
    },
    "SafeNonNegativeInteger": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "Sha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    },
    "Uuid": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$id": "https://shadow-auditor.dev/protocol/1.0/schemas/common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shadow Auditor Protocol Common Types"
}
