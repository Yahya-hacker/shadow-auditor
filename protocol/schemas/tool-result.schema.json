{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadow-auditor.dev/protocol/1.0/schemas/tool-result.schema.json",
  "title": "ToolResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "$ref": "./protocol-version.schema.json"
    },
    "resultId": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "proposalId": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "grantId": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "grantDigest": {
      "$ref": "./digest.schema.json"
    },
    "argumentsDigest": {
      "$ref": "./digest.schema.json"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "denied",
        "cancelled"
      ]
    },
    "output": {
      "$ref": "./json-value.schema.json"
    },
    "outputDigest": {
      "$ref": "./digest.schema.json"
    },
    "error": {
      "$ref": "./problem.schema.json"
    },
    "truncated": {
      "type": "boolean"
    },
    "originalByteLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1073741824
    },
    "request": {
      "$ref": "./signed-request-metadata.schema.json"
    }
  },
  "required": [
    "protocolVersion",
    "resultId",
    "sessionId",
    "proposalId",
    "grantId",
    "grantDigest",
    "argumentsDigest",
    "startedAt",
    "completedAt",
    "status",
    "outputDigest",
    "truncated",
    "originalByteLength",
    "request"
  ]
}
