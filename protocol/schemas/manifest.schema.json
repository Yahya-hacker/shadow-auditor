{
  "$defs": {
    "ManifestFile": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "$ref": "common.schema.json#/$defs/SafeNonNegativeInteger"
        },
        "path": {
          "maxLength": 256,
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?:protocol/[A-Za-z0-9._/-]+|scripts/generate-protocol\\.mjs|src/protocol/[A-Za-z0-9._/-]+)$",
          "type": "string"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/Sha256Digest"
        }
      },
      "required": [
        "bytes",
        "path",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$id": "https://shadow-auditor.dev/protocol/1.0/schemas/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonicalJson": {
      "additionalProperties": false,
      "properties": {
        "limits": {
          "additionalProperties": false,
          "properties": {
            "maxArrayItems": {
              "const": 1024,
              "type": "integer"
            },
            "maxBodyBytes": {
              "const": 1048576,
              "type": "integer"
            },
            "maxCanonicalDepth": {
              "const": 32,
              "type": "integer"
            },
            "maxCanonicalNodes": {
              "const": 10000,
              "type": "integer"
            },
            "maxEventBytes": {
              "const": 262144,
              "type": "integer"
            },
            "maxObjectKeys": {
              "const": 256,
              "type": "integer"
            },
            "maxStringBytes": {
              "const": 65536,
              "type": "integer"
            },
            "maxToolDescriptors": {
              "const": 128,
              "type": "integer"
            }
          },
          "required": [
            "maxArrayItems",
            "maxBodyBytes",
            "maxCanonicalDepth",
            "maxCanonicalNodes",
            "maxEventBytes",
            "maxObjectKeys",
            "maxStringBytes",
            "maxToolDescriptors"
          ],
          "type": "object"
        },
        "profile": {
          "const": "RFC 8785 JCS over strict I-JSON",
          "type": "string"
        },
        "unitSemantics": {
          "const": "maxStringBytes and maxBodyBytes count UTF-8 bytes; maxCanonicalDepth and maxCanonicalNodes are aggregate runtime limits not expressible by JSON Schema.",
          "type": "string"
        },
        "validationSteps": {
          "items": false,
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": "strict-json-parse"
            },
            {
              "const": "json-schema-2020-12"
            },
            {
              "const": "bounded-canonical-json"
            }
          ],
          "type": "array"
        }
      },
      "required": [
        "limits",
        "profile",
        "unitSemantics",
        "validationSteps"
      ],
      "type": "object"
    },
    "digestAlgorithm": {
      "const": "sha256",
      "type": "string"
    },
    "fileDigestSemantics": {
      "const": "SHA-256 over UTF-8 text after CRLF and CR normalization to LF; manifest.json is excluded to avoid self-reference.",
      "type": "string"
    },
    "files": {
      "items": false,
      "maxItems": 19,
