{
  "$defs": {
    "ActiveGrantsSnapshotPage": {
      "allOf": [
        {
          "$ref": "#/$defs/SnapshotPageBase"
        }
      ],
      "properties": {
        "collection": {
          "const": "activeGrants",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "tools.schema.json#/$defs/ToolGrant"
          },
          "maxItems": 128,
          "type": "array"
        }
      },
      "required": [
        "collection",
        "items"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "CreateSessionRequest": {
      "additionalProperties": false,
      "properties": {
        "deviceId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "intent": {
          "$ref": "#/$defs/MissionIntent"
        },
        "negotiatedCapabilitiesDigest": {
          "$ref": "common.schema.json#/$defs/Sha256Digest"
        },
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/ProtocolVersion"
        },
        "requestId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "sessionId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "tenantId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "toolDescriptors": {
          "items": {
            "$ref": "tools.schema.json#/$defs/ToolDescriptor"
          },
          "maxItems": 128,
          "type": "array"
        }
      },
      "required": [
        "protocolVersion",
        "tenantId",
        "deviceId",
        "sessionId",
        "requestId",
        "intent",
        "toolDescriptors",
        "negotiatedCapabilitiesDigest"
      ],
      "type": "object"
    },
    "DecisionsSnapshotPage": {
      "allOf": [
        {
          "$ref": "#/$defs/SnapshotPageBase"
        }
      ],
      "properties": {
        "collection": {
          "const": "decisions",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "tools.schema.json#/$defs/ToolDecision"
          },
          "maxItems": 128,
          "type": "array"
        }
      },
      "required": [
        "collection",
        "items"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "EventHead": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "cursor": {
              "const": 0,
              "type": "integer"
            },
            "eventHash": {
              "type": "null"
            }
          },
          "required": [
            "cursor",
            "eventHash"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "cursor": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "eventHash": {
              "$ref": "common.schema.json#/$defs/Sha256Digest"
            }
          },
          "required": [
            "cursor",
            "eventHash"
          ],
          "type": "object"
        }
      ],
      "title": "Coupled durable event head"
    },
    "GrantsSnapshotPage": {
      "allOf": [
        {
          "$ref": "#/$defs/SnapshotPageBase"
        }
      ],
      "properties": {
        "collection": {
          "const": "grants",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "tools.schema.json#/$defs/ToolGrant"
          },
          "maxItems": 128,
          "type": "array"
        }
      },
      "required": [
        "collection",
        "items"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "MissionIntent": {
      "additionalProperties": false,
      "properties": {
        "missionKind": {
          "enum": [
            "security-audit",
            "finding-verification",
            "remediation-planning"
          ],
          "type": "string"
        },
        "policyProfileId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "requestedCapabilities": {
          "items": {
            "$ref": "common.schema.json#/$defs/Identifier"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "targetFingerprint": {
          "$ref": "common.schema.json#/$defs/Sha256Digest",
          "description": "Digest-only target identity; repository contents and paths remain local."
        }
      },
      "required": [
        "missionKind",
        "targetFingerprint",
        "policyProfileId",
        "requestedCapabilities"
      ],
      "type": "object"
    },
    "OperationsSnapshotPage": {
      "allOf": [
        {
          "$ref": "#/$defs/SnapshotPageBase"
        }
      ],
      "properties": {
        "collection": {
          "const": "operations",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/RecoveredOperation"
          },
          "maxItems": 128,
          "type": "array"
        }
      },
      "required": [
        "collection",
        "items"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "PendingProposalsSnapshotPage": {
      "allOf": [
        {
          "$ref": "#/$defs/SnapshotPageBase"
        }
      ],
      "properties": {
        "collection": {
          "const": "pendingProposals",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "tools.schema.json#/$defs/ToolProposal"
          },
          "maxItems": 128,
          "type": "array"
        }
      },
      "required": [
        "collection",
        "items"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "ProposalsSnapshotPage": {
      "allOf": [
        {
          "$ref": "#/$defs/SnapshotPageBase"
        }
      ],
      "properties": {
        "collection": {
          "const": "proposals",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "tools.schema.json#/$defs/ToolProposal"
          },
          "maxItems": 128,
          "type": "array"
        }
      },
      "required": [
        "collection",
        "items"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "RecoveredOperation": {
      "additionalProperties": false,
      "description": "A durable operation plus the session whose recovery view contains it. The explicit session binding is required because authentication operations are tenant-scoped and Operation itself does not carry sessionId.",
      "properties": {
        "operation": {
          "$ref": "operations.schema.json#/$defs/Operation"
        },
        "sessionId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        }
      },
      "required": [
        "sessionId",
        "operation"
      ],
      "type": "object"
    },
    "ResultsSnapshotPage": {
      "allOf": [
        {
          "$ref": "#/$defs/SnapshotPageBase"
        }
      ],
      "properties": {
        "collection": {
          "const": "results",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "tools.schema.json#/$defs/ToolResult"
          },
          "maxItems": 128,
          "type": "array"
        }
      },
      "required": [
        "collection",
        "items"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "SessionCheckpoint": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "eventHead": {
          "$ref": "#/$defs/EventHead"
        },
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/ProtocolVersion"
        },
        "sessionId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "state": {
          "$ref": "#/$defs/SessionState"
        },
        "tenantId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "updatedAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        }
      },
      "required": [
        "protocolVersion",
        "tenantId",
        "sessionId",
        "state",
        "createdAt",
        "updatedAt",
        "eventHead"
      ],
      "type": "object"
    },
    "SessionControlRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "pause",
            "resume",
            "cancel"
          ],
          "type": "string"
        },
        "deviceId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/ProtocolVersion"
        },
        "reasonCode": {
          "enum": [
            "budget",
            "operator",
            "policy",
            "shutdown",
            "timeout"
          ],
          "type": "string"
        },
        "requestId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "sessionId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "tenantId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        }
      },
      "required": [
        "protocolVersion",
        "tenantId",
        "deviceId",
        "sessionId",
        "requestId",
        "action",
        "reasonCode"
      ],
      "type": "object"
    },
    "SessionSnapshotPage": {
      "oneOf": [
        {
          "$ref": "#/$defs/PendingProposalsSnapshotPage"
        },
        {
          "$ref": "#/$defs/DecisionsSnapshotPage"
        },
        {
          "$ref": "#/$defs/ProposalsSnapshotPage"
        },
        {
          "$ref": "#/$defs/GrantsSnapshotPage"
        },
        {
          "$ref": "#/$defs/ActiveGrantsSnapshotPage"
        },
        {
          "$ref": "#/$defs/ResultsSnapshotPage"
        },
        {
          "$ref": "#/$defs/OperationsSnapshotPage"
        }
      ]
    },
    "SessionState": {
      "enum": [
        "created",
        "planning",
        "awaiting-decision",
        "awaiting-result",
        "paused",
        "completed",
        "cancelled",
        "failed"
      ],
      "type": "string"
    },
    "SnapshotCollectionBoundaries": {
      "additionalProperties": false,
      "properties": {
        "activeGrants": {
          "$ref": "#/$defs/SnapshotCollectionBoundary"
        },
        "decisions": {
          "$ref": "#/$defs/SnapshotCollectionBoundary"
        },
        "grants": {
          "$ref": "#/$defs/SnapshotCollectionBoundary"
        },
        "operations": {
          "$ref": "#/$defs/SnapshotCollectionBoundary"
        },
        "pendingProposals": {
          "$ref": "#/$defs/SnapshotCollectionBoundary"
        },
        "proposals": {
          "$ref": "#/$defs/SnapshotCollectionBoundary"
        },
        "results": {
          "$ref": "#/$defs/SnapshotCollectionBoundary"
        }
      },
      "required": [
        "pendingProposals",
        "proposals",
        "decisions",
        "activeGrants",
        "grants",
        "results",
        "operations"
      ],
      "type": "object"
    },
    "SnapshotCollectionBoundary": {
      "additionalProperties": false,
      "description": "The immutable item count and terminal hash of the ordered per-record snapshot hash chain.",
      "properties": {
        "collectionDigest": {
          "$ref": "common.schema.json#/$defs/Sha256Digest"
        },
        "itemCount": {
          "$ref": "common.schema.json#/$defs/SafeNonNegativeInteger"
        }
      },
      "required": [
        "itemCount",
        "collectionDigest"
      ],
      "type": "object"
    },
    "SnapshotCollectionName": {
      "enum": [
        "pendingProposals",
        "proposals",
        "decisions",
        "activeGrants",
        "grants",
        "results",
        "operations"
      ],
      "type": "string"
    },
    "SnapshotCursor": {
      "additionalProperties": false,
      "properties": {
        "authorization": {
          "$ref": "common.schema.json#/$defs/DetachedSignature"
        },
        "projection": {
          "$ref": "#/$defs/SnapshotCursorProjection"
        }
      },
      "required": [
        "projection",
        "authorization"
      ],
      "type": "object"
    },
    "SnapshotCursorProjection": {
      "additionalProperties": false,
      "properties": {
        "collection": {
          "$ref": "#/$defs/SnapshotCollectionName"
        },
        "collectionDigest": {
          "$ref": "common.schema.json#/$defs/Sha256Digest"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "nextOffset": {
          "$ref": "common.schema.json#/$defs/PositiveSafeInteger"
        },
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/ProtocolVersion"
        },
        "sessionId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "snapshotId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "snapshotVersion": {
          "$ref": "common.schema.json#/$defs/PositiveSafeInteger"
        },
        "tenantId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        }
      },
      "required": [
        "protocolVersion",
        "tenantId",
        "sessionId",
        "snapshotId",
        "snapshotVersion",
        "collection",
        "collectionDigest",
        "nextOffset",
        "expiresAt"
      ],
      "type": "object"
    },
    "SnapshotCursorToken": {
      "description": "Unpadded base64url encoding of the exact UTF-8 strict canonical JSON SnapshotCursor. Decoding, canonical re-encoding, schema validation, signature validation, and scope validation are all mandatory.",
      "maxLength": 2048,
      "minLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "SnapshotPageBase": {
      "description": "Every complete page MUST pass bounded canonical validation. The server selects the longest ordered prefix, up to maxRecoveryPageItems, whose complete canonical page fits maxBodyBytes and maxCanonicalNodes; if records remain it MUST include at least one. Each item is independently bounded by maxRecoveryItemBytes, maxRecoveryItemDepth, and maxRecoveryItemNodes. The schema-bounded non-item envelope reserves maxRecoveryPageOverheadBytes and maxRecoveryPageOverheadNodes, while the page adds at most two depth levels, guaranteeing progress.",
      "properties": {
        "collectionBoundaries": {
          "$ref": "#/$defs/SnapshotCollectionBoundaries"
        },
        "createdAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "eventHead": {
          "$ref": "#/$defs/EventHead"
        },
        "nextCursor": {
          "oneOf": [
            {
              "$ref": "#/$defs/SnapshotCursorToken"
            },
            {
              "type": "null"
            }
          ]
        },
        "pageStart": {
          "$ref": "common.schema.json#/$defs/SafeNonNegativeInteger"
        },
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/ProtocolVersion"
        },
        "sessionId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "snapshotCreatedAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "snapshotExpiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "snapshotId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "snapshotVersion": {
          "$ref": "common.schema.json#/$defs/PositiveSafeInteger"
        },
        "state": {
          "$ref": "#/$defs/SessionState"
        },
        "tenantId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "updatedAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        }
      },
      "required": [
        "protocolVersion",
        "tenantId",
        "sessionId",
        "snapshotId",
        "snapshotVersion",
        "snapshotCreatedAt",
        "snapshotExpiresAt",
        "state",
        "createdAt",
        "updatedAt",
        "eventHead",
        "collectionBoundaries",
        "pageStart",
        "nextCursor"
      ],
      "type": "object",
      "x-max-canonical-bytes": 1048576
    }
  },
  "$id": "https://shadow-auditor.dev/protocol/1.0/schemas/sessions.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session and Recovery State"
}
