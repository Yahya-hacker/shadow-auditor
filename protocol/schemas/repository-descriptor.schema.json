{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadow-auditor.dev/protocol/1.0/schemas/repository-descriptor.schema.json",
  "title": "RepositoryDescriptor",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "dirty": {
      "type": "boolean"
    },
    "sourceMode": {
      "type": "string",
      "const": "tool-mediated"
    },
    "semanticIndexDigest": {
      "$ref": "./digest.schema.json"
    },
    "repositoryMapDigest": {
      "$ref": "./digest.schema.json"
    }
  },
  "required": [
    "repositoryId",
    "displayName",
    "revision",
    "dirty",
    "sourceMode",
    "semanticIndexDigest",
    "repositoryMapDigest"
  ]
}
