{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadow-auditor.dev/protocol/1.0/schemas/tool-descriptor.schema.json",
  "title": "ToolDescriptor",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "inputSchemaDigest": {
      "$ref": "./digest.schema.json"
    },
    "risk": {
      "type": "string",
      "enum": [
        "read",
        "write",
        "execute",
        "network",
        "privileged"
      ]
    },
    "maxResultBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777216
    }
  },
  "required": [
    "name",
    "description",
    "inputSchemaDigest",
    "risk",
    "maxResultBytes"
  ]
}
