{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadow-auditor.dev/protocol/1.0/schemas/public-key.schema.json",
  "title": "PublicKey",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "type": "string",
      "const": "ed25519"
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "publicKey": {
      "type": "string",
      "minLength": 43,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "algorithm",
    "keyId",
    "publicKey"
  ]
}
