{
  "name": "shadow-auditor",
  "description": "Autonomous AI-powered Static Application Security Testing (SAST) CLI",
  "version": "1.0.0",
  "author": "Yahya-hacker",
  "allowScripts": {
    "tree-sitter-go@0.21.2": true,
    "tree-sitter@0.21.1": true,
    "tree-sitter-javascript@0.21.4": true,
    "tree-sitter-javascript@0.23.1": true,
    "tree-sitter-python@0.21.0": true,
    "tree-sitter-typescript@0.23.2": true,
    "unrs-resolver@1.11.1": true
  },
  "bin": {
    "shadow-auditor": "./bin/run.js"
  },
  "bugs": "https://github.com/Yahya-hacker/shadow-auditor/issues",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.33",
    "@ai-sdk/google": "^4.0.36",
    "@ai-sdk/mistral": "^4.0.25",
    "@ai-sdk/openai": "^4.0.33",
    "@clack/prompts": "^1.2.0",
    "@langchain/anthropic": "^1.5.1",
    "@langchain/core": "^1.2.5",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/openai": "^1.5.3",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "ai": "^7.0.55",
    "cross-keychain": "^1.0.0",
    "dotenv": "^17.4.0",
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "ollama-ai-provider": "^1.2.0",
    "react": "^18.3.1",
    "tree-sitter": "0.21.1",
    "tree-sitter-go": "0.21.2",
    "tree-sitter-javascript": "0.21.4",
    "tree-sitter-python": "0.21.0",
    "tree-sitter-typescript": "0.23.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.14.1 <25",
    "npm": ">=11.5.1"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/Yahya-hacker/shadow-auditor",
  "keywords": [
    "oclif",
    "sast",
    "security",
    "ai",
    "vulnerability-scanner",
    "static-analysis"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "oclif": {
    "bin": "shadow-auditor",
    "dirname": "shadow-auditor",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " "
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yahya-hacker/shadow-auditor.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "node ./bin/run.js shell --reconfigure",
    "build": "shx rm -rf dist && tsc -b --force",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "npm run build && oclif manifest",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "test:native": "node --input-type=module -e \"import Parser from 'tree-sitter'; import Go from 'tree-sitter-go'; import JavaScript from 'tree-sitter-javascript'; import Python from 'tree-sitter-python'; import TypeScript from 'tree-sitter-typescript'; for (const [language, source] of [[Go, 'package main'], [JavaScript, 'const ok = true'], [Python, 'ok = True'], [TypeScript.typescript, 'const ok: boolean = true']]) { const parser = new Parser(); parser.setLanguage(language); if (parser.parse(source).rootNode.hasError) process.exit(1) }\"",
    "test:unit": "mocha --forbid-only \"test/**/*.test.ts\"",
    "verify": "npm run build && npm run test:unit && npm run lint && npm run test:native",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts",
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "picomatch": "^4.0.4",
    "brace-expansion": "^2.0.3"
  }
}
