{
  "name": "shadow-auditor",
  "description": "Autonomous AI-powered Static Application Security Testing (SAST) CLI",
  "version": "1.0.0",
  "author": "Yahya-hacker",
  "bin": {
    "shadow-auditor": "./bin/run.js"
  },
  "bugs": "https://github.com/Yahya-hacker/shadow-auditor/issues",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.5",
    "@ai-sdk/google": "^4.0.5",
    "@ai-sdk/mistral": "^4.0.3",
    "@ai-sdk/openai": "^4.0.5",
    "@clack/prompts": "^1.2.0",
    "@langchain/anthropic": "^1.5.1",
    "@langchain/core": "^1.2.1",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/openai": "^1.5.3",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "ai": "^7.0.11",
    "chalk": "^5.6.2",
    "@opentui/core": "^0.4.3",
    "@opentui/react": "^0.4.3",
    "ollama-ai-provider": "^1.2.0",
    "react": "^19.2.0",
    "tree-sitter": "^0.22.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-elixir": "^0.3.5",
    "tree-sitter-go": "^0.21.2",
    "tree-sitter-haskell": "^0.23.1",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/sarif": "^2.1.7",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "cross-keychain": "^1.0.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/Yahya-hacker/shadow-auditor",
  "keywords": [
    "oclif",
    "sast",
    "security",
    "ai",
    "vulnerability-scanner",
    "static-analysis"
  ],
  "license": "MIT",
  "type": "module",
  "oclif": {
    "bin": "shadow-auditor",
    "dirname": "shadow-auditor",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " "
  },
  "repository": "Yahya-hacker/shadow-auditor",
  "scripts": {
    "start": "node ./bin/run.js shell --reconfigure",
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts",
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "picomatch": "^4.0.4",
    "brace-expansion": "^2.0.3",
    "tree-sitter": "$tree-sitter"
  },
  "allowScripts": {
    "tree-sitter@0.22.4": true,
    "tree-sitter-c@0.23.6": true,
    "tree-sitter-cpp@0.23.4": true,
    "tree-sitter-elixir@0.3.5": true,
    "tree-sitter-go@0.21.2": true,
    "tree-sitter-haskell@0.23.1": true,
    "tree-sitter-html@0.23.2": true,
    "tree-sitter-java@0.23.5": true,
    "tree-sitter-javascript@0.21.4": true,
    "tree-sitter-javascript@0.23.1": true,
    "tree-sitter-json@0.24.8": true,
    "tree-sitter-python@0.21.0": true,
    "tree-sitter-ruby@0.23.1": true,
    "tree-sitter-scala@0.24.0": true,
    "tree-sitter-typescript@0.23.2": true,
    "unrs-resolver@1.11.1": true
  }
}
