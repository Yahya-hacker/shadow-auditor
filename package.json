{
  "name": "shadow-auditor",
  "description": "Autonomous AI-powered Static Application Security Testing (SAST) CLI",
  "version": "1.0.0",
  "author": "Yahya-hacker",
  "allowScripts": {
    "@tree-sitter-grammars/tree-sitter-markdown": true,
    "@tree-sitter-grammars/tree-sitter-toml": true,
    "@tree-sitter-grammars/tree-sitter-yaml": true,
    "tree-sitter": true,
    "tree-sitter-c": true,
    "tree-sitter-c-sharp": true,
    "tree-sitter-cpp": true,
    "tree-sitter-elixir": true,
    "tree-sitter-go": true,
    "tree-sitter-haskell": true,
    "tree-sitter-html": true,
    "tree-sitter-java": true,
    "tree-sitter-javascript": true,
    "tree-sitter-json": true,
    "tree-sitter-php": true,
    "tree-sitter-python": true,
    "tree-sitter-ruby": true,
    "tree-sitter-rust": true,
    "tree-sitter-scala": true,
    "tree-sitter-typescript": true,
    "unrs-resolver": true
  },
  "bin": {
    "shadow-auditor": "bin/run.js"
  },
  "bugs": "https://github.com/Yahya-hacker/shadow-auditor/issues",
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@clack/prompts": "^1.2.0",
    "@langchain/anthropic": "^1.5.1",
    "@langchain/core": "^1.2.1",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/mistralai": "^1.0.3",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.3",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@tree-sitter-grammars/tree-sitter-markdown": "^0.3.2",
    "@tree-sitter-grammars/tree-sitter-toml": "0.6.0",
    "@tree-sitter-grammars/tree-sitter-yaml": "0.6.1",
    "ai": "^7.0.11",
    "chalk": "^5.6.2",
    "chokidar": "^4.0.3",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-c": "^0.21.4",
    "tree-sitter-c-sharp": "^0.21.3",
    "tree-sitter-cpp": "0.23.2",
    "tree-sitter-elixir": "^0.3.5",
    "tree-sitter-go": "^0.21.2",
    "tree-sitter-haskell": "^0.23.1",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-php": "0.23.11",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.21.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/sarif": "^2.1.7",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "cross-keychain": "^1.0.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "files": [
    "./bin",
    "./dist",
    "./codebase-intelligence.txt",
    "./devil's advocate.txt",
    "./oclif.manifest.json",
    "./protocol",
    "./scripts/generate-protocol.mjs",
    "./sast-auditor.txt",
    "./src/protocol"
  ],
  "homepage": "https://github.com/Yahya-hacker/shadow-auditor",
  "keywords": [
    "oclif",
    "sast",
    "security",
    "ai",
    "vulnerability-scanner",
    "static-analysis"
  ],
  "license": "MIT",
  "type": "module",
  "oclif": {
    "bin": "shadow-auditor",
    "dirname": "shadow-auditor",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " "
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yahya-hacker/shadow-auditor.git"
  },
  "scripts": {
    "start": "node ./bin/run.js shell --reconfigure",
    "build": "shx rm -rf dist && tsc -b --force",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "protocol:check": "node scripts/generate-protocol.mjs --check",
    "protocol:generate": "node scripts/generate-protocol.mjs",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "relink": "npm install && npm run test:native && npm link",
    "test": "mocha --forbid-only --extension ts --recursive test",
    "test:native": "mocha --forbid-only \"test/**/*.test.ts\" --grep \"uses Tree-sitter AST chunking across guaranteed production languages\"",
    "test:unit": "mocha --forbid-only --extension ts --recursive test",
    "version": "oclif readme && git add README.md"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "picomatch": "^4.0.4",
    "brace-expansion": "^2.1.4",
    "diff": "^8.0.3",
    "uuid": "^11.1.1"
  }
}
